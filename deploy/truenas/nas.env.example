# Reglages de deploiement TrueNAS de Reencodearr, lus par deploy/truenas_create_app.py et deploy/truenas_agent_app.py.
# Copier ce fichier en /root/reencodearr.env sur le NAS (chmod 600), puis adapter.
# Autre emplacement : REENCODEARR_ENV=/chemin/vers/fichier. Une variable d'environnement de meme nom l'emporte.
# Ce fichier ne contient aucun secret : le mot de passe admin est genere dans REENCODEARR_CRED.

# Adresse du hub telle que les agents la joignent (IP ou nom du NAS + port)
REENCODEARR_PUBLIC_URL=http://192.168.1.10:8095
# Port publie par l'app hub (defaut 8095)
#REENCODEARR_PORT=8095

# Dossier de l'app hub sur le NAS ; ses donnees vont dans <dossier>/data (hub.db, affiches, staging)
REENCODEARR_BASE=/mnt/tank/apps/reencodearr
# Bibliotheque de series (un sous-dossier par serie), montee sur /series
REENCODEARR_SERIES=/mnt/tank/media/series
# Bibliotheque de films, montee sur /movies seulement si le dossier existe (vide : pas de films)
REENCODEARR_MOVIES=/mnt/tank/media/films
# Utilisateur:groupe du conteneur hub, qui doit pouvoir ecrire dans les bibliotheques (defaut 3000:0)
#REENCODEARR_USER=3000:0
# Fichier (root, 600) ou le mot de passe admin genere est ecrit et relu
#REENCODEARR_CRED=/root/reencodearr-identifiants.txt

# Agent GPU du NAS : dossier de l'app (jeton et travail dans <dossier>/data) et nom affiche dans l'onglet Hosts
REENCODEARR_AGENT_BASE=/mnt/tank/apps/reencodearr-agent
#REENCODEARR_AGENT_NAME=nas-gpu
# Adresse du hub vue par l'agent (defaut : REENCODEARR_PUBLIC_URL)
#REENCODEARR_HUB_URL=http://192.168.1.10:8095

# Registre des images (defaut ghcr.io/romain350). Vide : images locales construites avec docker build
#REENCODEARR_REGISTRY=ghcr.io/romain350
