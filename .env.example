# Copier en .env a cote de docker-compose.yml (lu automatiquement par docker compose), puis adapter.
# Adresse que les agents utilisent pour joindre le hub (IP ou nom de la machine + port)
PUBLIC_URL=http://192.168.1.10:8095
# Bibliotheques (une sous-dossier par serie / par film) et donnees du hub
SERIES_PATH=/chemin/vers/series
MOVIES_PATH=/chemin/vers/films
DATA_PATH=./data
# Utilisateur:groupe du conteneur, qui doit pouvoir ecrire dans les bibliotheques
PUID=3000
PGID=0
# Facultatif : cree le compte admin au demarrage. Vide : l'assistant le cree au premier acces a l'interface
ADMIN_USER=admin
ADMIN_PASSWORD=
